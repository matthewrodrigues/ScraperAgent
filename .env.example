# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so never
# put a real secret here.
#
# After creating .env, restrict it to your user account (Windows):
#   icacls .env /inheritance:r /grant:r "%USERNAME%:F"

# ---- Dashboard authentication (required) ----
# The dashboard spends money and acts on your eBay account, so it is closed by
# default. An empty DASHBOARD_PASSWORD locks the dashboard rather than opening
# it. Pick something long; you type it rarely.
DASHBOARD_PASSWORD=

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random one is generated per boot and you are logged out on every
# restart.
SESSION_SECRET=

# ---- API keys ----
ANTHROPIC_API_KEY=
APIFY_TOKEN=

# eBay Trading API (messaging, offer status, and the seller-reply poller).
# App ID + Cert ID are sent as request headers (integrations/ebay_trading.py);
# listing search no longer uses these — discovery now runs through the Apify
# actor instead of the Browse API.
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_ENV=production

# eBay Trading API (GetMyMessages, used by the seller-reply poller). A legacy
# Auth'n'Auth token, valid ~18 months. Best Offer placement does NOT use this —
# it goes through the Playwright browser session instead.
EBAY_USER_TOKEN=

# ---- eBay Marketplace Account Deletion notification (production keysets) ----
# Must be a stable public HTTPS URL. With Cloudflare Tunnel this is your tunnel
# hostname plus the path, and it stops changing every time you restart.
EBAY_DELETION_ENDPOINT_URL=
EBAY_DELETION_VERIFICATION_TOKEN=

# ---- Paths (optional) ----
# Defaults keep everything in the repo root, which is the historical layout.
# SCRAPERAGENT_DATA_DIR moves the database and secrets together; the per-path
# vars override it individually. Templates and static assets are code and never
# move.
# SCRAPERAGENT_DATA_DIR=
# SCRAPERAGENT_DB_PATH=
# SCRAPERAGENT_SECRETS_DIR=

# ---- Backups (optional) ----
# Where `python -m scripts.backup_profile` writes Chrome-profile archives.
# Defaults to ~/ScraperAgentBackups — outside the repo and outside OneDrive, so
# weekly multi-hundred-MB archives don't get cloud-synced.
# SCRAPERAGENT_BACKUP_DIR=
# SCRAPERAGENT_BACKUP_KEEP=5

# ---- Tuning knobs (optional; defaults shown) ----
# Hard per-search cap covering discovery (eBay listings) plus reference
# pricing (Google Shopping) combined.
# APIFY_BUDGET_USD=0.90

# Ceiling for one eBay discovery run. The actor has no input-level result
# cap, so this ceiling is what stops the scrape, not a margin over an
# estimate — a broad query routinely reaches the full $0.15 (~75 scraped
# results at $0.002 each). Separate from APIFY_BUDGET_USD because the key
# broker debits friends the declared ceiling.
# EBAY_SEARCH_BUDGET_USD=0.15
# MAX_PARALLEL_NEGOTIATIONS=5
# MAX_ROUNDS=3
# SELLER_TIMEOUT_HOURS=24

# Background seller-reply poller. Leave enabled for normal local use — it needs
# a valid EBAY_USER_TOKEN. Set to false in any environment without eBay creds,
# or the loop logs an error every interval.
# SELLER_POLL_ENABLED=true
# SELLER_POLL_INTERVAL_SECONDS=300

# ---- eBay browser automation (optional; defaults shown) ----
# EBAY_BROWSER_CHANNEL=chrome
# EBAY_BROWSER_HEADED=true
# EBAY_BROWSER_PROFILE_DIR=
# EBAY_BROWSER_SCREENSHOTS_DIR=

# ---- Key broker (friends only) ----
# Set both to route Anthropic and Apify through someone else's broker.
# Leave both empty to use your own ANTHROPIC_API_KEY / APIFY_TOKEN.
SCRAPERAGENT_BROKER_URL=
SCRAPERAGENT_BROKER_TOKEN=

# ---- Key broker (broker host only) ----
BROKER_GLOBAL_MONTHLY_BUDGET_USD=25.00
BROKER_PORT=8001
