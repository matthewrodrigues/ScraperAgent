.venv/
.env
browser_profile/
screenshots/
__pycache__/
*.pyc
.pytest_cache/

# Secrets dir — keep the directory structure (.gitkeep) but exclude every
# actual secret file (session state, OAuth tokens, etc.)
secrets/*
!secrets/.gitkeep
!secrets/screenshots/
secrets/screenshots/*
!secrets/screenshots/.gitkeep

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Local database — created on first boot, never committed
scraperagent.db
scraperagent.db-journal
scraperagent.db-wal
scraperagent.db-shm

# Broker ledger: friend token hashes and spend. Never commit.
broker.db
broker.db-journal
broker.db-wal
